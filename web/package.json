{
  "name": "aaa1024-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "aaa1024 —— 卡牌改造武器的俯视角实时动作肉鸽（Phaser 3 + TypeScript + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit && vite build",
    "data:validate": "node scripts/validate-data.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "art:build": "node scripts/art/build-art.mjs",
    "format": "prettier --write \"src/**/*.{ts,json}\""
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
