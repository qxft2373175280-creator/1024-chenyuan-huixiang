{
  "name": "aaa1024-web",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "aaa1024 —— 卡牌改造武器的俯视角实时动作肉鸽（Phaser 3 + TypeScript + Vite）",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "check": "tsc --noEmit && vite build",
    "data:validate": "node scripts/validate-data.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "art:build": "node scripts/art/build-art.mjs",
    "pack:itch": "node scripts/pack-itch.mjs",
    "deploy:itch": "node scripts/deploy-itch.mjs",
    "acc:tutorial": "node scripts/acceptance/acc-tutorial.mjs",
    "acc:blueprint": "node scripts/acceptance/acc-blueprint.mjs",
    "acc:parry": "node scripts/acceptance/acc-parry.mjs",
    "acc:parry-room": "node scripts/acceptance/acc-parry-room.mjs",
    "acc:e2e": "node scripts/acceptance/acc-e2e.mjs",
    "acc:saveio": "node scripts/acceptance/acc-saveio.mjs",
    "acc:challenge": "node scripts/acceptance/acc-challenge.mjs",
    "acc:layout": "node scripts/acceptance/acc-layout.mjs",
    "format": "prettier --write \"src/**/*.{ts,json}\"",
    "acc:combat": "node scripts/acceptance/acc-combat.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
