# 统一行尾，避免跨平台 diff 混乱
* text=auto

# Unity 序列化文件统一 LF
*.cs text eol=lf
*.shader text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.meta text eol=lf

# Windows 批处理必须 CRLF，否则 cmd 会静默失败
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制资源不经过文本转换
*.png binary
*.jpg binary
*.jpeg binary
*.psd binary
*.tga binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.mp4 binary
*.ttf binary
*.otf binary

# 处理大二进制时建议启用 Git LFS（团队统一安装 git-lfs 后再启用）
# *.png filter=lfs diff=lfs merge=lfs -text
# *.fbx filter=lfs diff=lfs merge=lfs -text
# *.wav filter=lfs diff=lfs merge=lfs -text